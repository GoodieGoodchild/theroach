# The Roach — Apache config for xneelo shared hosting.
#
# ── Canonical host ────────────────────────────────────────────────────────────
# One host, one protocol. The OLD indexed URLs were https://www.theroach.co.za,
# so keep www to inherit that history. Enable SSL in the xneelo panel first — the
# canonical, sitemap and these rules all target https://www., and without a
# certificate every one of them lands on a browser warning.

RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.theroach.co.za%{REQUEST_URI} [L,R=301]

# ── The old WooCommerce catalogue: 410 Gone, NOT 301 ──────────────────────────
#
# This was originally a blanket 301 of every old URL to the homepage. That was
# wrong twice over, and the reasons matter:
#
#  1. TECHNICALLY. Google treats a mass redirect of many dissimilar URLs onto one
#     unrelated homepage as a soft 404 — it passes little or no equity, while
#     keeping the URL alive in the index far longer than a 410 would. The thing
#     the 301 was meant to achieve, it does not achieve.
#
#  2. SUBSTANTIVELY, and this is the more important one. Those URLs are a cannabis
#     retail catalogue: /product-category/flowers/, /brand/african-cannamed-co/,
#     extracts, pre-rolls, paraphernalia. 301ing them onto a page that states
#     "nothing is offered for sale" asserts continuity between the two — the
#     site's own redirect map contradicting the site's own disclaimer. 410 says
#     the opposite, and says it in a way Google acts on quickly: this is gone.
#
# Google's index still describes this domain as "Cannabis Club in Knysna" selling
# extracts and flower. Until that corpus is out of the index, every bit of SEO
# attention drawn to the domain also surfaces it.

RedirectMatch 410 ^/shop(/.*)?$
RedirectMatch 410 ^/product-category(/.*)?$
RedirectMatch 410 ^/product(/.*)?$
RedirectMatch 410 ^/brand(/.*)?$
RedirectMatch 410 ^/cannarootz(/.*)?$
RedirectMatch 410 ^/cart(/.*)?$
RedirectMatch 410 ^/checkout(/.*)?$
RedirectMatch 410 ^/my-account(/.*)?$

# WordPress plumbing — gone, and never worth a redirect.
RedirectMatch 410 ^/wp-(admin|login|content|includes|json)(/.*)?$
RedirectMatch 410 ^/xmlrpc\.php$

# ── 301 only where the intent genuinely continues ─────────────────────────────
# The contact page is the one old URL whose visitor wants the same thing today.
Redirect 301 /contact-us-the-roach/ https://www.theroach.co.za/

# ── Serve a real page for 410s so visitors aren't dumped on a bare error ──────
ErrorDocument 410 /410.html
ErrorDocument 404 /404.html

# ── Caching / compression ─────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
